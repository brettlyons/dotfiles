{
  "mcpServers": {
    "ledger": {
      "command": "docker",
      "args": [
        "run",
        "-v",
        "/home/blyons/finances/main.ledger:/main.ledger",
        "-e",
        "LEDGER_FILE=/main.ledger",
        "-i",
        "--rm",
        "minhyeoky/mcp-ledger"
      ]
    },
    "nixos": {
      "command": "nix",
      "args": ["run", "github:utensils/mcp-nixos", "--"]
    },
    "taskwarrior": {
      "command": "npx",
      "args": ["-y", "mcp-server-taskwarrior"]
    }
  }
}